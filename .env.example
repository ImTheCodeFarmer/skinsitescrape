# Postgres / TimescaleDB connection (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgres://casino:casino@localhost:5437/casino

# Collector
SITES=rustypot,csgogem
PROXY_URL=http://user:pass@proxy.example:1337
LOG_LEVEL=info

# Legacy scraper database, read by `pnpm --filter collector backfill` (see README "Importing legacy history")
LEGACY_DB_HOST=
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# LEGACY_DB_PORT=5432
# LEGACY_DB_SSL=true
# BACKFILL_BATCH=1000
# BACKFILL_PAUSE_MS=250
