# Postgres / TimescaleDB connection (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgres://casino:casino@localhost:5437/casino

# Web: signs the login cookie (any long random string). Optional; without it a key is derived from DATABASE_URL.
SESSION_SECRET=
# Web: public URL Steam sends users back to after sign-in. Optional; defaults to the request's own host.
# NEXT_PUBLIC_SITE_URL=https://stats.example.com
# Web: Steam ids allowed into /admin, comma-separated. Optional; defaults to the owner's id.
# ADMIN_STEAM_IDS=76561199469037234
# Web + collector: key for the stored Telegram bot tokens. Optional; falls back to SESSION_SECRET, then a key derived from DATABASE_URL. Rotating it invalidates stored tokens.
# ALERTS_SECRET=
# Web: contact form (/contact). Messages go to one Telegram chat: create a bot with @BotFather, add it to the chat
# (or message it yourself), then read the chat id from https://api.telegram.org/bot<token>/getUpdates.
# CONTACT_TELEGRAM_BOT_TOKEN=
# CONTACT_TELEGRAM_CHAT_ID=
# Optional: a topic in a group with topics turned on, the message_thread_id shown in getUpdates for a message in that topic.
# CONTACT_TELEGRAM_THREAD_ID=
# Web: Cloudflare Turnstile keys for the contact form (Cloudflare dashboard > Turnstile > Add widget). Without the secret the
# check is skipped in development and every submission is refused in production.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Collector: Steam profile enrichment for Steam-keyed players. Optional key (100 profiles per request with it, one per request without);
# STEAM_RPS requests per second across all Steam calls (default 0.5), STEAM_DAILY_MAX per day (default 15000), STEAM_ENRICH=false to switch off.
# STEAM_API_KEY=
# STEAM_RPS=0.5
# STEAM_DAILY_MAX=15000
# Collector: public dashboard URL, used for the profile link in Telegram alerts. Optional.
# PUBLIC_WEB_URL=https://stats.example.com

# Collector
SITES=rustypot,csgogem,cases,clash,rusteasy,banditcamp,rustmagic,rustyloot,csgoroll
PROXY_URL=http://user:pass@proxy.example:1337
LOG_LEVEL=info

# Legacy scraper database, read by `pnpm --filter collector backfill` (see README "Importing legacy history")
LEGACY_DB_HOST=
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# LEGACY_DB_PORT=5432
# LEGACY_DB_SSL=true
# BACKFILL_BATCH=1000
# BACKFILL_PAUSE_MS=250
