# Postgres / TimescaleDB connection (Railway injects DATABASE_URL automatically)
DATABASE_URL=postgres://casino:casino@localhost:5437/casino

# Web: signs the login cookie (any long random string). Optional; without it a key is derived from DATABASE_URL.
SESSION_SECRET=
# Web: public URL Steam sends users back to after sign-in. Optional; defaults to the request's own host.
# NEXT_PUBLIC_SITE_URL=https://stats.example.com
# Web: Steam ids allowed into /admin, comma-separated. Optional; defaults to the owner's id.
# ADMIN_STEAM_IDS=76561199469037234

# Collector
SITES=rustypot,csgogem,cases,clash,rusteasy,banditcamp,rustmagic,rustyloot,csgoroll
PROXY_URL=http://user:pass@proxy.example:1337
LOG_LEVEL=info

# Legacy scraper database, read by `pnpm --filter collector backfill` (see README "Importing legacy history")
LEGACY_DB_HOST=
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
# LEGACY_DB_PORT=5432
# LEGACY_DB_SSL=true
# BACKFILL_BATCH=1000
# BACKFILL_PAUSE_MS=250
