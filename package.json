{
  "name": "casino-stats",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:collector": "pnpm --filter collector dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @casino/db migrate",
    "db:up": "docker compose up -d db"
  }
}
