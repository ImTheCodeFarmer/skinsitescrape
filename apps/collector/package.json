{
  "name": "collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=source --env-file=../../.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "discover": "node --conditions=source --env-file=../../.env --import tsx src/scripts/discover.ts",
    "reparse": "node --conditions=source --env-file=../../.env --import tsx src/scripts/reparse.ts",
    "build:wstap": "cd wstap && go build -o wstap ."
  },
  "dependencies": {
    "@casino/db": "workspace:*",
    "https-proxy-agent": "^7.0.6",
    "pino": "^9.7.0",
    "playwright-core": "1.63",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5"
  }
}
