DATABASE_URL=postgres://casino:casino@localhost:5437/casino
SITES=rustypot,csgogem
PROXY_URL=http://user:pass@proxy.example:1337
# Hunt for a clean exit: a fresh _session-<id> per refusal, hold the one that connects. Set false to disable.
PROXY_STICKY=true
# Refusals in a row before pausing 5 minutes.
PROXY_HUNT_MAX=40
# wstap (default: Go client with Chrome's TLS fingerprint, socket only)
# browser (headed Chrome fallback, needs CHROME_PATH locally) | socketio (plain client, blocked by Cloudflare on rustypot)
TRANSPORT=wstap
# WSTAP_PATH=/path/to/wstap   (defaults to apps/collector/wstap/wstap)
# Only when the egress IP gets challenged (residential proxies): a cf_clearance cookie minted by a
# real Chrome on the same sticky-session IP, and that browser's exact user agent.
# WS_COOKIE=cf_clearance=...
# WS_UA=Mozilla/5.0 (...) Chrome/152.0.0.0 Safari/537.36
LOG_LEVEL=info
RECORD_RAW=true
