{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/web/Dockerfile",
    "watchPatterns": ["/apps/web/**", "/packages/db/**", "pnpm-lock.yaml", "pnpm-workspace.yaml", "package.json"]
  },
  "deploy": {
    "preDeployCommand": ["node db/dist/migrate.js"],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
